syntax "erlang" "\.erl$"
header "^#!.*escript\b"
comment "%"

# Reserved words.
color bold,lightwhite "\b(after|and(also)?|b(and|not|or|sl|sr|xor)|begin)\b"
color bold,lightwhite "\b(case|catch|cond|div|else|end|fun|if|let|maybe|not)\b"
color bold,lightwhite "\b(of|or(else)?|receive|rem|try|when|xor)\b"

color black,white "[^ -~]"

# Comments.
color lightblack "%.*"

# Shebangs.
color bold,lightwhite "^#!.*escript\b.*"
color ,white "\s+$"
