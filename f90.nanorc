syntax "f90" "\.f90$"
comment "!"

# Reserved words.
color bold,lightwhite "\b(subroutine|implicit|if|else|else\s*if)\b"
color bold,lightwhite "\b(end\s*(if|subroutine|do)|do|return|none|call|real)\b"
color bold,lightwhite "\b(integer|intent|continue|go\s*to|dimension)\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "!.*"

color ,white "\s+$"
