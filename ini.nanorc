syntax "INI" "\.(ini|conf|cfg|gitconfig|git/config)$"
header "^\s*\[[a-z]+( \"[a-z]+\")?\]\s*([#;].*)?$"
comment "#"
color white,black ".*"

# Headers.
color brightwhite "^\s*\[[a-z]+( \"[a-z]+\")?\]\s*([#;].*)?$"

color black,white "[^ -~]"

# Comments.
color brightblack "[#;].*"

color ,white "\s+$"
