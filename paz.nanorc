syntax "PAZ" "\.paz$"
header "^#!.*paz\b"
comment "#"
color white,black ".*"
color brightwhite "\b(import|extern|namespace|return|class|with|and|or|for|if|while|try|catch|throw|else|true|false|in|local|static|const|auto|self|cast|from)\b"
color brightblack "(^|\s)#.*"
color brightwhite "^#!.*paz\b.*"
color ,white "	|\s+$"
