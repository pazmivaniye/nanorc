syntax "PAZ" "\.paz$"
header "^#!.*paz\b"
comment "#"
color white,black ".*"

# Reserved words.
color brightwhite "\b(import|extern|namespace|return|class|with|and|or|for)\b"
color brightwhite "\b(if|while|try|catch|throw|else|true|false|in|local)\b"
color brightwhite "\b(static|const|auto|self|cast|from)\b"

color black,white "[^ -~]"

# Comments.
color brightblack "(^|\s)#.*"

# Shebangs.
color brightwhite "^#!.*paz\b.*"

color ,white "\s+$"
