syntax "GLSL" "\.(frag|vert|glsl)$"
comment "//"
color white,black ".*"

# Reserved words.
color brightwhite "\b(for|if|while|do|else|case|default|switch|bool|float)\b"
color brightwhite "\b(int|uint|uniform|in|out|inout|return)\b"
color brightwhite "\b(([ui])?(vec|mat)[2-4]|void|layout|const|struct)\b"
color brightwhite "\b([ui])?sampler[1-3]D\b"
color brightwhite "\b(texture|textureSize|fract|min|max|mix|clamp|abs)\b"
color brightwhite "\b(smoothstep|pow|mul|sin|cos|tan|asin|acos|atan|atan2)\b"
color brightwhite "\b(normalize|length)\b"
icolor brightwhite "gl_[a-z_0-9]+"

# Preprocessor macros.
color brightwhite "^\s*#(define|if|endif|else|elif|ifdef|ifndef|undef)\b"
color brightwhite "^\s*#(include|pragma|error|version|extension)\b"

color black,white "[^ -~]"

# Comments.
color brightblack "//.*"
color brightblack "/\*.*\*/"
color brightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color brightblack start="/\*" end="\*/"

color ,white "\s+$"
