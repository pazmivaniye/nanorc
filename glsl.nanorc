syntax "glsl" "\.(frag|vert|glsl)$"
comment "//"

# Reserved words.
color bold,lightwhite "\b(for|if|while|do|else|case|default|switch|bool)\b"
color bold,lightwhite "\b(float|u?int|uniform|in|out|inout|return)\b"
color bold,lightwhite "\b(([ui])?(vec|mat)[2-4]|void|layout|const|struct)\b"
color bold,lightwhite "\b([ui])?sampler[1-3]D\b"
color bold,lightwhite "\b(texture|textureSize|fract|min|max|mix|clamp|abs)\b"
color bold,lightwhite "\b(smoothstep|pow|mul|sin|cos|tan|asin|acos|atan)\b"
color bold,lightwhite "\b(atan2|normalize|length)\b"
icolor bold,lightwhite "gl_[a-z_0-9]+"

# Preprocessor macros.
color bold,lightwhite "^\s*#(define|if|endif|else|elif|ifdef|ifndef|undef)\b"
color bold,lightwhite "^\s*#(include|pragma|error|version|extension)\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "//.*"
color italic,lightblack "/\*.*\*/"
color italic,lightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color italic,lightblack start="/\*" end="\*/"

color ,white "\s+$"
