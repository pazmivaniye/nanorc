syntax "php" "\.php$"
comment "//"

# Tags.
color bold,lightwhite "</?[^[:space:]\"'>/=]+|[/?]?>"

# Reserved words.
color bold,lightwhite "\b(echo|if|else(if)?|function|include(_once)?)\b"
color bold,lightwhite "\b(require(_once)?|return|echo|for(each)?|global|as)\b"
color bold,lightwhite "\b(continue|break)\b"
icolor bold,lightwhite "\b(true|false)\b"

color black,white "[^ -~]"

# Comments.
color lightblack start="<!--" end="-->"
color lightblack "//.*"
color lightblack "/\*.*\*/"
color lightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color lightblack start="/\*" end="\*/"

color ,white "\s+$"
