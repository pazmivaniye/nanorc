syntax "c" "\.((c(c|pp|xx)?|C)|(h(h|pp|xx)?|H)|ii?|def)$"
comment "//"

# Reserved words.
color bold,lightwhite "\b(float|double|bool|char|wchar_t|int|short|long)\b"
color bold,lightwhite "\b(sizeof|enum|void|static|const|struct|union|typedef)\b"
color bold,lightwhite "\b(extern|(un)?signed|inline)\b"
color bold,lightwhite "\b(class|namespace|template|public|protected|private)\b"
color bold,lightwhite "\b(typename|this|friend|virtual|using|mutable)\b"
color bold,lightwhite "\b(volatile|register|explicit|false|true)\b"
color bold,lightwhite "\b(for|if|while|do|else|case|default|switch)\b"
color bold,lightwhite "\b(try|throw|catch|operator|new|delete|errno)\b"
color bold,lightwhite "\b((const|dynamic|reinterpret|static)(_pointer)?_cast)\b"
color bold,lightwhite "\b(alignas|alignof|asm|auto|compl|concept|constexpr)\b"
color bold,lightwhite "\b(decltype|export|noexcept|nullptr|requires)\b"
color bold,lightwhite "\b(static_assert|thread_local|typeid)\b"
color bold,lightwhite "\b(and(_eq)?|bit(and|or)|not(_eq)?|x?or(_eq)?)\b"
color bold,lightwhite "\b(goto|continue|break|return)\b"
icolor bold,lightwhite "[a-z_0-9]*__[a-z_0-9]*"
color bold,lightwhite "\b_[A-Z][A-Za-z_0-9]*"

# Preprocessor macros.
color bold,lightwhite "^\s*#(define|if|endif|else|elif|ifdef|ifndef|undef)\b"
color bold,lightwhite "^\s*#(include|pragma|error)\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "//.*"
color italic,lightblack "/\*.*\*/"
color italic,lightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color italic,lightblack start="/\*" end="\*/"

color ,white "\s+$"
