syntax "Haskell" "(\.hs|\bcabal/config)$"
header "^(#!.*runhaskell\b|\s*\{-#))"
comment "--"
color white,black ".*"
color brightwhite "\b(as|case|class|data(\s+(family|instance))?|default|deriving(\s+instance)?|m?do|else|for(all|eign)|hiding|if|import|in(fix[lr]?|stance)?|let|module|newtype|of|proc|qualified|rec|then|type(\s+(family|instance))?|where)\b"
color brightblack "\{-.*-\}"
color brightblack "\{-([^-]*|[^-]*-[^\}]*)"
color brightblack start="\{-" end="-\}"
color brightwhite "^\s*\{-#[^\}#]*#-\}\s*(--.*)?$"
color brightblack "--.*"
color brightwhite "^#!.*runhaskell\b.*"
color ,white "	|\s+$"
