syntax "Haskell" "(\.hs|\bcabal/config)$"
header "^\s*\{-#"
color white,black ".*"
color brightwhite "\b(do|shows?|print|False|True|Bool|Char|String|data|deriving|IO|IOError|Maybe|Either|Ordering|Nothing|Just|Left|Right|LT|EQ|GT|not|Eq|Ord|ReadS?|ShowS?|Bounded|Enum|class|type|where|Real|Num(eric)?|Fractional|Integral|RealFrac|Floating|Monad|RealFloat|MonadPlus|Functor|sequence_?|mapM_?|abs|signum|even|odd|quot(Rem)?|div(Mod)?|mod(ule)?|rem|reads?|case|error|of|main|otherwise|if|else|then|let|zip(With)?3?|unzip3?|Ratio|Complex|Ix|Array|List|Directory|System|Time|Locale|CPUTime|Random)\b"
color brightblack "\{-.*-\}"
color brightblack "\{-([^-]*|[^-]*-[^\}]*)"
color brightblack start="\{-" end="-\}"
color brightwhite "^\s*\{-#[^\}#]*#-\}\s*(--.*)?$"
color brightblack "--.*$"
color ,white "	|\s+$"
