syntax "haskell" "(\.hs|\bcabal/config)$"
header "^(#!.*runhaskell\b|\s*\{-#)"
comment "--"

# Reserved words.
color bold,lightwhite "\b(as|case|class|data(\s+(family|instance))?)\b"
color bold,lightwhite "\b(default|deriving(\s+instance)?|m?do|else)\b"
color bold,lightwhite "\b(for(all|eign)|hiding|if|import)\b"
color bold,lightwhite "\b(in(fix[lr]?|stance)?|let|module|newtype|of|proc)\b"
color bold,lightwhite "\b(qualified|rec|then|type(\s+(family|instance))?)\b"
color bold,lightwhite "\bwhere\b"
color normal,normal "\b(as|case|class|data(\s+(family|instance))?|default)'"
color normal,normal "\b(deriving(\s+instance)?|m?do|else|for(all|eign)|hiding)'"
color normal,normal "\b(if|import|in(fix[lr]?|stance)?|let|module|newtype|of)'"
color normal,normal "\b(proc|qualified|rec|then|type(\s+(family|instance))?)'"
color normal,normal "\bwhere'"
color normal,normal "'(as|case|class|data(\s+(family|instance))?|default)\b"
color normal,normal "'(deriving(\s+instance)?|m?do|else|for(all|eign)|hiding)\b"
color normal,normal "'(if|import|in(fix[lr]?|stance)?|let|module|newtype|of)\b"
color normal,normal "'(proc|qualified|rec|then|type(\s+(family|instance))?)\b"
color normal,normal "'where\b"

# Pragmas.
color bold,lightwhite "\{-#\s+(COLUMN|COMPLETE|CONLIKE|DEPRECATED|INCLUDE)\b"
color bold,lightwhite "\{-#\s+(INCOHERENT|INLINE?ABLE|LANGUAGE|LINE|MINIMAL)\b"
color bold,lightwhite "\{-#\s+((NO)?INLINE|(NO)?UNPACK|OPAQUE|OPTIONS_GHC)\b"
color bold,lightwhite "\{-#\s+(OVERLAP(PABLE|PING|S)|RULES|SOURCE)\b"
color bold,lightwhite "\{-#\s+(SPECIALI[SZ]E(\s+(NO)?INLINE)?|WARNING)\b"
color normal,normal "\{-#"

color black,white "[^ -~]"

# Comments.
color lightblack "\{-\s.*\s-\}"
color lightblack start="\{-(\s[^\}]*)?$" end="^([^\{]*\s)?-\}"
color lightblack "--.*"

# Shebangs.
color bold,lightwhite "^#!.*runhaskell\b.*"

color ,white "\s+$"
