syntax "metal" "\.metal$"
comment "//"
color white,black ".*"

# Reserved words.
color brightwhite "\b(float|double|bool|char|int|short|long|sizeof|enum|void)\b"
color brightwhite "\b(static|const|struct|union|typedef|extern|(un)?signed)\b"
color brightwhite "\binline\b"
color brightwhite "\b(class|namespace|template|public|protected|private)\b"
color brightwhite "\b(typename|this|friend|virtual|using|mutable|volatile)\b"
color brightwhite "\b(register|explicit|false|true)\b"
color brightwhite "\b(for|if|while|do|else|case|default|switch)\b"
color brightwhite "\b(try|throw|catch|operator|new|delete)\b"
color brightwhite "\b((const|dynamic|reinterpret|static)_cast)\b"
color brightwhite "\b(alignas|alignof|asm|auto|compl|concept|constexpr)\b"
color brightwhite "\b(decltype|export|noexcept|nullptr|requires)\b"
color brightwhite "\b(static_assert|thread_local|typeid)\b"
color brightwhite "\b(and|and_eq|bitand|bitor|not|not_eq|or|or_eq|xor|xor_eq)\b"
color brightwhite "\b(goto|continue|break|return)\b"
icolor brightwhite "[a-z_0-9]*__[a-z_0-9]*"
color brightwhite "\b_[A-Z][A-Za-z_0-9]*"
color brightwhite "\b(float|half)([2-4](x[2-4])?)?\b"
color brightwhite "\bu?(char|short|int|long)([2-4])?\b"
color brightwhite "\b(device|constant|threadgroup|thread)\b"
color brightwhite "\b(vertex|fragment)\b"

# Preprocessor macros.
color brightwhite "^\s*#(define|if|endif|else|elif|ifdef|ifndef|undef)\b"
color brightwhite "^\s*#(include|pragma|error)\b"
color brightwhite "^\s*#import\b"

color black,white "[^ -~]"

# Comments.
color brightblack "//.*"
color brightblack "/\*.*\*/"
color brightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color brightblack start="/\*" end="\*/"

color ,white "\s+$"
