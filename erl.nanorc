syntax "Erlang" "\.erl$"
header "^#!.*escript\b"
comment "%"
color white,black ".*"

# Reserved words.
color brightwhite "\b(after|and(also)?|b(and|not|or|sl|sr|xor)|begin|case)\b"
color brightwhite "\b(catch|cond|div|else|end|fun|if|let|maybe|not|of)\b"
color brightwhite "\b(or(else)?|receive|rem|try|when|xor)\b"

color black,white "[^ -~]"

# Comments.
color brightblack "%.*"

# Shebangs.
color brightwhite "^#!.*escript\b.*"
color ,white "\s+$"
