syntax "python" "(\.pyi?|(^|/|\\)SCons(truct|cript))$"
header "^#!.*python[0-9]*\b"
comment "#"

# Reserved words.
color bold,lightwhite "\b(and|as|assert|async|await|break|class|continue|def)\b"
color bold,lightwhite "\b(del|elif|else|except|False|finally|for|from|global)\b"
color bold,lightwhite "\b(if|import|in|is|lambda|None|nonlocal|not|or|pass)\b"
color bold,lightwhite "\b(raise|return|True|try|while|with|yield|case|type)\b"

# Dunders.
color bold,lightwhite "\b__(abs|add|aenter|aexit|aiter|all|and|anext)__\b"
color bold,lightwhite "\b__(annotate|annotations|args|await|bases|bool)__\b"
color bold,lightwhite "\b__(bound|buffer|builtins|bytes|cached|call|cause)__\b"
color bold,lightwhite "\b__(ceil|class|class_getitem|classcell|closure)__\b"
color bold,lightwhite "\b__(code|complex|constraints|contains|context)__\b"
color bold,lightwhite "\b__(contravariant|copy|covariant|debug|deepcopy)__\b"
color bold,lightwhite "\b__(defaults|del|delattr|delete|delitem|dict|dir)__\b"
color bold,lightwhite "\b__(divmod|doc|dunder|enter|eq|exit|file)__\b"
color bold,lightwhite "\b__(firstlineno|float|floor|floordiv|format|fspath)__\b"
color bold,lightwhite "\b__(func|future|ge|get|getattr|getattribute)__\b"
color bold,lightwhite "\b__(getitem|getnewargs|getnewargs_ex|getstate)__\b"
color bold,lightwhite "\b__(globals|gt|hash|iadd|iand|ifloordiv|ilshift)__\b"
color bold,lightwhite "\b__(imatmul|imod|import|imul|index|infer_variance)__\b"
color bold,lightwhite "\b__(init|init_subclass|instancecheck|int|invert)__\b"
color bold,lightwhite "\b__(ior|ipow|irshift|isub|iter|itruediv|ixor)__\b"
color bold,lightwhite "\b__(kwdefaults|le|len|length_hint|loader|lshift|lt)__\b"
color bold,lightwhite "\b__(main|match_args|matmul|missing|mod|module|mro)__\b"
color bold,lightwhite "\b__(mro_entries|mul|name|ne|neg|new|next|notes)__\b"
color bold,lightwhite "\b__(objclass|or|origin|package|parameters|path|pos)__\b"
color bold,lightwhite "\b__(post_init|pow|prepare|qualname|radd|rand)__\b"
color bold,lightwhite "\b__(rdivmod|reduce|reduce_ex|release_buffer)__\b"
color bold,lightwhite "\b__(replace|repr|reversed|rfloordiv|rlshift)__\b"
color bold,lightwhite "\b__(rmatmul|rmod|rmul|ror|round|rpow|rrshift)__\b"
color bold,lightwhite "\b__(rshift|rsub|rtruediv|rxor|self|set|set_name)__\b"
color bold,lightwhite "\b__(setattr|setitem|setstate|sizeof|slots|spec)__\b"
color bold,lightwhite "\b__(static_attributes|stderr|stdout|str|sub)__\b"
color bold,lightwhite "\b__(subclasscheck|subclasses|subclasshook)__\b"
color bold,lightwhite "\b__(suppress_context|traceback|truediv|trunc)__\b"
color bold,lightwhite "\b__(type_params|unpacked|version|weakref|wrapped)__\b"
color bold,lightwhite "\b__xor__\b"

# Match statements.
color bold,lightwhite "^\s*match\b"

# Decorators.
icolor bold,lightwhite "^\s*@[a-z_][a-z_0-9]*"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "(^|\s)#.*"

# Shebangs.
color bold,lightwhite "^#!.*python[0-9]*\b.*"

color ,white "\s+$"
