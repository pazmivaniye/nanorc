syntax "Python" "(\.pyi?|(^|/|\\)SCons(truct|cript))$"
header "^#!.*python[0-9]*\b"
comment "#"
color white,black ".*"

# Reserved words.
color brightwhite "\b(and|as|assert|async|await|break|class|continue|def|del)\b"
color brightwhite "\b(elif|else|except|False|finally|for|from|global|if)\b"
color brightwhite "\b(import|in|is|lambda|None|nonlocal|not|or|pass|raise)\b"
color brightwhite "\b(return|True|try|while|with|yield|case|type)\b"

# Dunders.
color brightwhite "\b__(abs|add|aenter|aexit|aiter|all|and|anext|annotate)__\b"
color brightwhite "\b__(annotations|args|await|bases|bool|bound|buffer)__\b"
color brightwhite "\b__(builtins|bytes|cached|call|cause|ceil|class)__\b"
color brightwhite "\b__(class_getitem|classcell|closure|code|complex)__\b"
color brightwhite "\b__(constraints|contains|context|contravariant|copy)__\b"
color brightwhite "\b__(covariant|debug|deepcopy|defaults|del|delattr)__\b"
color brightwhite "\b__(delete|delitem|dict|dir|divmod|doc|dunder|enter|eq)__\b"
color brightwhite "\b__(exit|file|firstlineno|float|floor|floordiv|format)__\b"
color brightwhite "\b__(fspath|func|future|ge|get|getattr|getattribute)__\b"
color brightwhite "\b__(getitem|getnewargs|getnewargs_ex|getstate|globals)__\b"
color brightwhite "\b__(gt|hash|iadd|iand|ifloordiv|ilshift|imatmul|imod)__\b"
color brightwhite "\b__(import|imul|index|infer_variance|init)__\b"
color brightwhite "\b__(init_subclass|instancecheck|int|invert|ior|ipow)__\b"
color brightwhite "\b__(irshift|isub|iter|itruediv|ixor|kwdefaults|le|len)__\b"
color brightwhite "\b__(length_hint|loader|lshift|lt|main|match_args)__\b"
color brightwhite "\b__(matmul|missing|mod|module|mro|mro_entries|mul|name)__\b"
color brightwhite "\b__(ne|neg|new|next|notes|objclass|or|origin|package)__\b"
color brightwhite "\b__(parameters|path|pos|post_init|pow|prepare|qualname)__\b"
color brightwhite "\b__(radd|rand|rdivmod|reduce|reduce_ex|release_buffer)__\b"
color brightwhite "\b__(replace|repr|reversed|rfloordiv|rlshift|rmatmul)__\b"
color brightwhite "\b__(rmod|rmul|ror|round|rpow|rrshift|rshift|rsub)__\b"
color brightwhite "\b__(rtruediv|rxor|self|set|set_name|setattr|setitem)__\b"
color brightwhite "\b__(setstate|sizeof|slots|spec|static_attributes)__\b"
color brightwhite "\b__(stderr|stdout|str|sub|subclasscheck|subclasses)__\b"
color brightwhite "\b__(subclasshook|suppress_context|traceback|truediv)__\b"
color brightwhite "\b__(trunc|type_params|unpacked|version|weakref|wrapped)__\b"
color brightwhite "\b__xor__\b"

# Match statements.
color brightwhite "^\s*match\b"

# Decorators.
icolor brightwhite "^\s*@[a-z_][a-z_0-9]*"

# Comments.
color brightblack "(^|\s)#.*"

# Shebangs.
color brightwhite "^#!.*python[0-9]*\b.*"

color ,white "	|\s+$"
