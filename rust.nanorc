syntax "Rust" "\.rs$"
comment "//"
color white,black ".*"
color brightwhite "\b(fn|use|let|mut|match|loop|break|continue|for|in|pub|struct|impl|where|self|else|as|extern|crate|trait)\b"
color brightblack "//.*"
color brightblack "/\*.*\*/"
color brightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color brightblack start="/\*" end="\*/"
color ,white "	|\s+$"
