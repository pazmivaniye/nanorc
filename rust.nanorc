syntax "rust" "\.rs$"
comment "//"

# Reserved words.
color bold,lightwhite "\b(fn|use|let|mut|match|loop|break|continue|for|in)\b"
color bold,lightwhite "\b(pub|struct|impl|where|self|else|as|extern|crate)\b"
color bold,lightwhite "\btrait\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack "//.*"
color italic,lightblack "/\*.*\*/"
color italic,lightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color italic,lightblack start="/\*" end="\*/"

color ,white "\s+$"
