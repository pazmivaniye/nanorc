syntax "cython" "\.pyx$"
header "^\s*# cython:"
comment "#"

# Reserved words.
color bold,lightwhite "\b(and|as|assert|async|await|break|class|continue|def)\b"
color bold,lightwhite "\b(del|elif|else|except|False|finally|for|from|global)\b"
color bold,lightwhite "\b(if|import|in|is|lambda|None|nonlocal|not|or|pass)\b"
color bold,lightwhite "\b(raise|return|True|try|while|with|yield|case|type)\b"

# Dunders.
color bold,lightwhite "\b__(abs|add|aenter|aexit|aiter|all|and|anext|annotate)__\b"
color bold,lightwhite "\b__(annotations|args|await|bases|bool|bound|buffer)__\b"
color bold,lightwhite "\b__(builtins|bytes|cached|call|cause|ceil|class)__\b"
color bold,lightwhite "\b__(class_getitem|classcell|closure|code|complex)__\b"
color bold,lightwhite "\b__(constraints|contains|context|contravariant|copy)__\b"
color bold,lightwhite "\b__(covariant|debug|deepcopy|defaults|del|delattr)__\b"
color bold,lightwhite "\b__(delete|delitem|dict|dir|divmod|doc|dunder|enter|eq)__\b"
color bold,lightwhite "\b__(exit|file|firstlineno|float|floor|floordiv|format)__\b"
color bold,lightwhite "\b__(fspath|func|future|ge|get|getattr|getattribute)__\b"
color bold,lightwhite "\b__(getitem|getnewargs|getnewargs_ex|getstate|globals)__\b"
color bold,lightwhite "\b__(gt|hash|iadd|iand|ifloordiv|ilshift|imatmul|imod)__\b"
color bold,lightwhite "\b__(import|imul|index|infer_variance|init)__\b"
color bold,lightwhite "\b__(init_subclass|instancecheck|int|invert|ior|ipow)__\b"
color bold,lightwhite "\b__(irshift|isub|iter|itruediv|ixor|kwdefaults|le|len)__\b"
color bold,lightwhite "\b__(length_hint|loader|lshift|lt|main|match_args)__\b"
color bold,lightwhite "\b__(matmul|missing|mod|module|mro|mro_entries|mul|name)__\b"
color bold,lightwhite "\b__(ne|neg|new|next|notes|objclass|or|origin|package)__\b"
color bold,lightwhite "\b__(parameters|path|pos|post_init|pow|prepare|qualname)__\b"
color bold,lightwhite "\b__(radd|rand|rdivmod|reduce|reduce_ex|release_buffer)__\b"
color bold,lightwhite "\b__(replace|repr|reversed|rfloordiv|rlshift|rmatmul)__\b"
color bold,lightwhite "\b__(rmod|rmul|ror|round|rpow|rrshift|rshift|rsub)__\b"
color bold,lightwhite "\b__(rtruediv|rxor|self|set|set_name|setattr|setitem)__\b"
color bold,lightwhite "\b__(setstate|sizeof|slots|spec|static_attributes)__\b"
color bold,lightwhite "\b__(stderr|stdout|str|sub|subclasscheck|subclasses)__\b"
color bold,lightwhite "\b__(subclasshook|suppress_context|traceback|truediv)__\b"
color bold,lightwhite "\b__(trunc|type_params|unpacked|version|weakref|wrapped)__\b"
color bold,lightwhite "\b__xor__\b"

# Match statements.
color bold,lightwhite "^\s*match\b"

# Decorators.
icolor bold,lightwhite "^\s*@[a-z_][a-z_0-9]*"

# Cython reserved words.
color bold,lightwhite "\b(cimport|complex|c(p|type)?def|extern|(no)?gil)\b"
color bold,lightwhite "\b(packed|(un)?signed)\b"

# Cython types.
color bold,lightwhite "\b(b?int|bool|byte(array|s)|char|classmethod|dict)\b"
color bold,lightwhite "\b(double|enum(erate)?|filter|float|(frozen)?set|list)\b"
color bold,lightwhite "\b(long|map|memoryview|object|property)\b"
color bold,lightwhite "\b(Py_(ssize_t|hash_t|UCS4)|range|reversed|short)\b"
color bold,lightwhite "\b(size_t|slice|staticmethod|str(uct)?|tuple|union)\b"
color bold,lightwhite "\b(void|zip)\b"

# Preprocessor macros.
color bold,lightwhite "^\s*(DEF|IF|ELIF|ELSE)\b"

color black,white "[^ -~]"

# Comments.
color lightblack "(^|\s)#.*"

color ,white "\s+$"
