syntax "LaTeX" "\.(tex|cls|sty|bib|bst)$"
color white,black ".*"
color brightwhite "\\([A-Za-z%@]+|[[\"~'^`#=.!|;,:]|\])"
color brightwhite "\\left[([<|.]|\\middle[|.]|\\right([)>|.]|\])"
color white,black "\\\\([A-Za-z%@]+|[[\"~'^`#=.!|;,:]|\])"
color white,black "\\[_%&${}#][A-Za-z_0-9]+"
color brightwhite "\\\\\*?"
color brightwhite "\\[_%&${}#]"
color brightblack "%.*"
color ,white "	|\s+$"
