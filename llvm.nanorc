syntax "llvm" "\.ll$"
comment ";"

# Types.
color bold,lightwhite "\b([bi][1-9][0-9]*|label|ptr|token|type|void)\b"

# Instructions.
color bold,lightwhite "\b(add|and|(addrspace|bit)cast|(addr|int)toptr|alloca)\b"
color bold,lightwhite "\b(bit(extract|insert)|(indirect|call)?br|call)\b"
color bold,lightwhite "\b(de(clare|fine)|(extract|insert)(element|value))\b"
color bold,lightwhite "\bf(neg|add|sub|mul|div|rem|cmp|ptrunc|pext)\b"
color bold,lightwhite "\b(getelementptr|icmp|load|mul|x?or|phi)\b"
color bold,lightwhite "\b(ptrto(addr|int)|ret|[su](div|rem|itofp)|select)\b"
color bold,lightwhite "\b([sz]ext|store|sub|switch|trunc|unreachable)\b"

# Constants.
color bold,lightwhite "\b(inf|false|none|null|opaque|[sq]?nan|true|undef)\b"

# Attributes.
color bold,lightwhite "\b(align|argmem|attributes|captures|cold|constant)\b"
color bold,lightwhite "\b(dereferenceable|dis(joint|tinct)|(ex|in)ternal|eq)\b"
color bold,lightwhite "\b(global|hot|immarg)\b"
color bold,lightwhite "\bin(accessiblemem|bounds|range|reg)\b"
color bold,lightwhite "\b(local|metadata|memory|mustprogress|ne|nneg)\b"
color bold,lightwhite "\bno(alias|callback|free|re(curse|turn)|sync)\b"
color bold,lightwhite "\bnoun(def|wind)\b"
color bold,lightwhite "\b((no|sign|zero)ext|nonnull|n[su]w|private|range)\b"
color bold,lightwhite "\b((read|write)(only)?|readwrite|samesign)\b"
color bold,lightwhite "\b([su][gl][et]|speculatable|tail|to)\b"
color bold,lightwhite "\b((local_)?unnamed_addr|willreturn)\b"

icolor normal,normal "[!%@]([a-z_.\-][a-z_0-9.\-]*|\"[^\"]*\")"

# Labels.
icolor bold,lightwhite "^\s*([a-z_.\-][a-z_0-9.\-]*|\"[^\"]*\"):\s*(;.*)?$"

# Other.
color bold,lightwhite "^\s*(source_filename|target\striple)\b"

color black,white "[^ -~]"

# Comments.
color italic,lightblack ";.*"
color italic,lightblack "/\*.*\*/"
color italic,lightblack "/\*([^\*]*|[^\*]*\*[^/]*)"
color italic,lightblack start="/\*" end="\*/"

color ,white "\s+$"
