syntax "powershell" "\.(ps([cdm]?1|1xml|[rs]c)|cdxml)$"
header "^#!.*powershell\b"
comment "<#|#>"
color black,white "[^ -~]"

# Comments.
color lightblack "(^|\s)#($|\s.*)"
color lightblack "<#.*#>"
color lightblack "<#([^#]*|[^#]*#[^>]*)"
color lightblack start="<#" end="#>"

# Shebangs.
color bold,lightwhite "^#!.*powershell\b.*"

color ,white "\s+$"
