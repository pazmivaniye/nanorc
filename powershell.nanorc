syntax "powershell" "\.(ps([cdm]?1|1xml|[rs]c)|cdxml)$"
header "^#!.*powershell\b"
comment "<#|#>"
color black,white "[^ -~]"

# Comments.
color italic,lightblack "(^|\s)#($|\s.*)"
color italic,lightblack "<#.*#>"
color italic,lightblack "<#([^#]*|[^#]*#[^>]*)"
color italic,lightblack start="<#" end="#>"

# Shebangs.
color bold,lightwhite "^#!.*powershell\b.*"

color ,white "\s+$"
