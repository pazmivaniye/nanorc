syntax "julia" "\.jl$"
header "^#!.*julia\b"
comment "#"

# Reserved words.
color bold,lightwhite "\b(if|elseif|else|end|using|import|mutable|struct)\b"
color bold,lightwhite "\b(export|function|for|return|while|in|undef|true)\b"
color bold,lightwhite "\b(false|break|continue)\b"
icolor bold,lightwhite "@[a-z_][a-z_0-9]*"

color black,white "[^ -~]"

# Comments.
color lightblack "(^|\s)#.*"

# Shebangs.
color bold,lightwhite "^#!.*julia\b.*"

color ,white "\s+$"
