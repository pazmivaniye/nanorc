syntax "Julia" "\.jl$"
header "^#!.*julia\b"
comment "#"
color white,black ".*"
color brightwhite "\b(if|elseif|else|end|using|import|mutable|struct|export|function|for|return|while|in|undef|true|false|break|continue)\b"
icolor brightwhite "@[a-z_][a-z_0-9]*"
color brightblack "(^|\s)#.*"
color brightwhite "^#!.*julia\b.*"
color ,white "	|\s+$"
